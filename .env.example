# Copie para .env.local e preencha. Nunca versione .env.local.

# --- Públicas (vão para o navegador; seguras porque o acesso é controlado por RLS) ---
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# Chave "publishable" (sb_publishable_...). A chave "anon" legada também funciona
# em NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_exemplo

# Política de privacidade: responsável pelo tratamento e canal de contato (informar o cliente)
NEXT_PUBLIC_PRIVACY_CONTROLLER=
NEXT_PUBLIC_PRIVACY_CONTACT=

# --- Exclusivas do servidor ---
# Nenhuma. O app NÃO usa a chave service_role: a exclusão de conta é feita pela
# função delete_my_account() no banco, executada com a sessão da própria pessoa.

# Login social opcional. Liste só os provedores já habilitados no Supabase
# (Authentication → Providers), separados por vírgula: google,apple
NEXT_PUBLIC_AUTH_PROVIDERS=
